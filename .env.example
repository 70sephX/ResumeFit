# Optional: enable real LLM analysis. Without this, the app runs in clearly labeled demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: enable Stripe TEST checkout, completed payments grant credits via webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The public website origin (change for production deployment); no trailing slash
APP_BASE_URL=http://127.0.0.1:8001

# On hosted HTTPS deployments, set to true.
COOKIE_SECURE=false

# Optional: where the SQLite file lives (point at a persistent disk when hosted)
# DATABASE_PATH=/var/data/resumefit.db
